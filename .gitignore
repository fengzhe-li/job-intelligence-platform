__pycache__/
*.py[cod]
.pytest_cache/
.venv/
dist/
build/
*.egg-info/
.DS_Store
.env
.env.*

# Local runtime state: real candidate profile (name, CV text, contact details),
# raw scraped job snapshots, and processed rankings. Never publish this.
data/local/
# Ephemeral local-browser runtime (isolated Chrome profiles, session records). Never business
# state, never backed up or copied with data/local.
data/runtime/
# Timestamped backups of data/local taken before data migrations -- same
# personal data, same rule.
data/backups/

# Raw working notes behind the CV tailoring policy / regression fixture. They
# describe real past applications; only the derived YAML assets are published.
data/policies/sources/
tests/fixtures/sources/
# Curated Evidence Bank content for the candidate's own projects (including
# private repositories) -- personal profile data, kept local-only.
src/jobintel/evidence_enrichment.py
tests/test_phase36_evidence_enrichment.py
docs/PHASE_3_6_EVIDENCE_BANK_ENRICHMENT.md
# The real candidate's facts (contact, address, immigration status, education, employment,
# self-declared answers) used by the Answer Bank and question resolver -- personal data. The
# public code ships without it and fails closed to human input (see candidate_facts.py).
src/jobintel/submission/candidate_facts_local.py
# Tests that assert the real candidate's facts or need the curated evidence module above.
tests/test_authoritative_answer_bank.py
tests/test_submission_handoff.py
tests/test_profile_links_authoritative.py
tests/test_internship_experience_master.py
tests/test_internship_evidence_budget.py
tests/test_promotion_non_destructive.py
# One-off operator helpers bound to real request/session ids.
scratchpad/

# Candidate-specific per-job choices and private Evidence Bank integration checks.
config/cv_positioning_overrides.json
tests/test_curated_evidence_paths.py

# Generated application documents and local stores must never enter a release.
*.pdf
*.docx
*.doc
*.bak
*.backup
cover_letters/
cv_artifacts/
sealed_packages/
package_store/
browser_profiles/
backups/

# Local credentials and key material.
*.pem
*.key
credentials.json
secrets.json
